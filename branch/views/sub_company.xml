<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="branch_sub_company_view_tree" model="ir.ui.view">
            <field name="name">branch.sub.company.view.tree</field>
            <field name="model">sub.company</field>
            <field name="arch" type="xml">
                <tree string="Sub Company" editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>
    <record id="sub_company_action_branch" model="ir.actions.act_window">
            <field name="name">Sub Company</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sub.company</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click here to create a new sub company.
                </p>
            </field>
        </record>

    <menuitem id="branch_menu_sub_company" name="Sub Company" parent="base.menu_users" action="sub_company_action_branch"/>
</odoo>