<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="cash_payment_branch_manager_rule" model="ir.rule">
            <field name="name">Cash Payment Manager</field>
            <field name="model_id" ref="model_cash_payments"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('branch.group_branch_user_manager'))]"/>
        </record>

        <record id="cash_payment_user_branch_rule" model="ir.rule">
            <field name="name">Cash Payment User Branch</field>
            <field name="model_id" ref="model_cash_payments"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('branch_id','=',user.branch_id.id)]</field>
            <field name="groups" eval="[(4, ref('branch.group_branch_user'))]"/>
        </record>

<!--        <record id="cash_payment_user_rule" model="ir.rule">-->
