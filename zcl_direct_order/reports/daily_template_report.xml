<odoo>
    <data>
        <template id="report_sale_order_daily">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <header>
                        <style>
                            table, th, td {
                            border:1px solid black;
                            border-collapse: collapse;
                            }
                        </style>
                    </header>
                    <div align="center">
                        <h2>Daily Sale Order Report</h2>
                    </div>
                    <br/>
                    <table clas="table table-bordered" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Sl.No</th>
                                <th>Items</th>
                                <th>Invoice number</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="index" t-value="1"/>
                            <t t-foreach="list_data" t-as="line">
                                <tr>
                                    <td>
                                        <t t-esc="index"/>
                                    </td>
                                    <td>
                                        <t t-esc="line['product']"/>
                                    </td>
                                    <td>
                                        <t t-esc="line['invoice_number']"/>
                                    </td>

                                    <td>
                                        <t t-esc="line['quantity']"/>
                                    </td>
                                </tr>
                                <t t-set="index" t-value="index+1"/>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>
    </data>
</odoo>
