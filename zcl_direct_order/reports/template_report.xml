<odoo>
    <data>
        <template id="report_sale_order">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <header>
                        <style>
                            table, th, td {
                            border:1px solid black;
                            border-collapse: collapse;
                            }
                        </style>
                    </header>
                    <div align="center">
                        <h2>Delivery Order Report</h2>
                    </div>
                    <br/>
                    <br/>
                    <div>
                        <h5>
                            Date from:
                            <t t-if="list_data and list_data[0].get('date_from')">
                                <t t-esc="list_data[0]['date_from']"/>
                            </t>
                        </h5>
                        <h5>
                            Date To:
                            <t t-if="list_data and list_data[0].get('date_to')">
                                <t t-esc="list_data[0]['date_to']"/>
                            </t>

                        </h5>
                    </div>
                    <br/>
                    <br/>
                    <table clas="table table-bordered" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Sl.No</th>
                                <th>DO Number</th>
                                <th>Invoice number</th>
                                <th>Product</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="index" t-value="1"/>
                            <t t-foreach="list_data" t-as="data">
                                <tr>
                                    <td>
                                        <t t-esc="index"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['do_number']"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['invoice_number']"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['product']"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['quantity']"/>
                                    </td>
                                </tr>
                                <t t-set="index" t-value="index+1"/>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>
    </data>
</odoo>


