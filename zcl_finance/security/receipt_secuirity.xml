<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="bank_receipt_user_branch_rule" model="ir.rule">
        <field name="name">Bank Receipt User Branch</field>
        <field name="model_id" ref="model_bank_receipt"/>
        <field name="domain_force">[('branch_id','=',user.branch_id.id)]</field>
        <field name="groups" eval="[(4, ref('branch.group_branch_user'))]"/>
    </record>

    <record id="bank_receipt_manager_rule" model="ir.rule">
            <field name="name">Bank Receipt Manager Access</field>
            <field name="model_id" ref="model_bank_receipt"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('branch.group_branch_user_manager'))]"/>
        </record>
</data>
</odoo>