<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

<!--        """Set automatic action for calculate target achievement         -->
<!--        in month wise check first day of a month"""                      -->

        <record id="ir_cron_check_incentive_achievement" model="ir.cron">
            <field name="name">Check incentive achievement</field>
            <field name="model_id" ref="model_salesman_incentive"/>
            <field name="state">code</field>
            <field name="code">model.check_target_achievement()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
             <field name="nextcall" eval="(DateTime.now().replace(day=1) + relativedelta(months=1)).replace(hour=0, minute=0, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>