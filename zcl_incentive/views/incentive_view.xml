<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="salesman_incentive_view_form" model="ir.ui.view">
        <field name="name">salesman.incentive.view.form</field>
        <field name="model">salesman.incentive</field>
        <field name="arch" type="xml">
            <form>
                <header>
<!--                <button name="action_compute_incentive" string="Compute" type="object" class="oe_highlight"/>-->
            </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
<!--                    <widget name="web_ribbon" title="achieved"-->
<!--                                attrs="{'invisible': [('amount_achieved', '=', 0)]}"/>-->
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. shop target"/>
                            <field name="amount" string="Target Amount"/>
                            <field name="showroom_incharge" invisible="1"/>
                            <field name="assistant_amount" invisible="1"/>
                            <field name="salesman_amount" invisible="1"/>
                        </group>
                        <group>
                            <field name="branch_id"/>
                            <field name="current_date" invisible="1" force_save="1"/>
                            <field name="date_from" invisible="1" force_save="1"/>
                            <field name="date_to" invisible="1" force_save="1"/>
<!--                            <label for="date_from" string="Planned Date" invisible="1"/>-->
<!--                            <div name="dates" class="o_row">-->
<!--                                <field name="date_from" widget="daterange" options='{"related_end_date": "date_to"}' force_save="1"/>-->
<!--                                <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>-->
<!--                                <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow" attrs="{'invisible': [('date_from', '=', False), ('date_to', '=', False)]}"/>-->
<!--                                <field name="date_to" widget="daterange" options='{"related_start_date": "date_start"}' force_save="1"/>-->
<!--                            </div>-->
                            <field name="amount_achieved" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="incentive" string="Previous Incentive">
                            <field name="line_ids">
                                <tree create="0" edit="0" delete="0">
                                    <field name="year"/>
                                    <field name="month"/>
                                    <field name="amount"/>
                                    <field name="amount_achieved"/>
                                    <field name="status" decoration-success="status == 'done'"
                                                         decoration-danger="status == 'fail' "
                                                         widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="salesman_incentive_view_tree" model="ir.ui.view">
        <field name="name">salesman.incentive.view.tree</field>
        <field name="model">salesman.incentive</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="amount" string="Target Amount"/>
<!--                <field name="amount_achieved"/>-->
<!--                <field name="date_from"/>-->
<!--                <field name="date_to"/>-->
<!--                <field name="showroom_incharge" optional="hide"/>-->
<!--                <field name="assistant_amount" optional="hide"/>-->
<!--                <field name="salesman_amount" optional="hide"/>-->
            </tree>
        </field>
    </record>
    <record id="action_salesman_incentive" model="ir.actions.act_window">
        <field name="name">Target Setting and Incentive</field>
        <field name="res_model">salesman.incentive</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
