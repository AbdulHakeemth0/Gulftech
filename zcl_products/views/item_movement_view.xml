<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zcl_item_movement_form_view" model="ir.ui.view">
        <field name="name">item.movement.form</field>
        <field name="model">item.movement</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <div class="oe_title">
                        <label for="product_id" class="oe_edit_only"/>
                        <h1><field name="product_id" string="Product" placeholder="e.g Product"/></h1>
                    </div>
<!--                    <group>-->
<!--                        <field name="product_id"/>-->
<!--                    </group>-->
                        <notebook><page string="Item Movements">
                        <field name="item_movement_ids" widget="one2many" no_label="True">
                        <tree editable="bottom" readonly="1">
                            <field name="product_code"/>
                            <field name="location_id"/>
                            <field name="sales_count"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                        </tree>
                        </field>
                        </page>
                        </notebook>

                </sheet>
            </form>
        </field>
    </record>
<record id="item_movement_action" model="ir.actions.act_window">
        <field name="name">Item Movement</field>
        <field name="res_model">item.movement</field>
        <field name="view_mode">form</field>
    </record>
</odoo>