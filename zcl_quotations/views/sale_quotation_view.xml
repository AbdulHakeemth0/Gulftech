<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    sale quotation form view-->
    <record id="sale_quotation_view_form" model="ir.ui.view">
        <field name="name">sale.quotation.view.form</field>
        <field name="model">sale.quotation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sale"/>
                    <button name="sale_confirm" string="Confirm"
                            type="object" class="oe_highlight" states="draft"/>
                    <button name="sale_cancel" string="Cancel"
                            type="object"
                            states="sale"/>
                    <button name="sale_draft" string="Draft"
                            type="object"
                            states="sale,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" invisible="1"/>
                            <field name="sequence_number" readonly="1"/>
                            <field name="walkin_customer_bool" invisible="1" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   options="{'create': false, 'create_edit': false,'no_create':True,'no_open': True}"/>
                            <field name="payment_term" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   options="{'create': false, 'create_edit': false}"/>
                            <field name="payment_terms" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   options="{'create': false, 'create_edit': false}"/>
                            <field name="delivery_terms" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   options="{'create': false, 'create_edit': false}"/>
                            <field name="sales_man_id" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   options="{'create': false, 'create_edit': false,'no_create':True,'no_open': True}"/>
                        </group>
                        <group>
                            <field name="date" string="Creation Date" widget="date"/>
                            <field name="branch_id" readonly="1"/>
                            <!--                            <field name="gsm_number_customer"/>-->
                            <field name="gsm_number_customer"
                                   attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('walkin_customer_bool','!=', False)]}"
                                   string="GSM No"/>
                            <field name="gsm_number"
                                   attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('walkin_customer_bool','!=', True)]}"
                                   string="GSM No"/>
                            <field name="customer_name"
                                   attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('walkin_customer_bool','!=', True)]}"/>
                            <field name="customer_address"
                                   attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('walkin_customer_bool','!=', True)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <field name="sno" readonly="1" force_save="1"/>
                                    <field name="items_id"
                                           domain="[('sale_ok', '=', True), ('state','=','done'),('detailed_type','=','product'),('invoice_policy','=','order')]"
                                           options="{'no_create':True,'no_open': True}" force_save="1"
                                           context="{'show_default_code': True}"/>
                                    <field name="item_id"
                                           domain="[('sale_ok', '=', True), ('state','=','done'),('detailed_type','=','product'),('invoice_policy','=','order')]"
                                           options="{'no_create':True,'no_open': True}" force_save="1" invisible="1"/>
                                    <field name="description" force_save="1"/>
                                    <field name="units" force_save="1"/>
                                    <field name="qty" force_save="1"/>
                                    <field name="rate" force_save="1"/>
                                    <field name="gross" force_save="1"/>
                                    <field name="sale_type" force_save="1"/>
                                    <field name="discount_on_foc" force_save="1"/>
                                    <field name="bottom_price" force_save="1"/>
                                    <field name="net_value" force_save="1"/>
                                    <field name="stock_in_hand" force_save="1"/>
                                </tree>
                            </field>
                            <div>
                                <group>
                                    <group>
                                        <group>
                                            <field name="total_qty" readonly="1" force_save="1"/>
                                            <field name="total_stock_in_hand" readonly="1" force_save="1"/>
                                        </group>
                                        <group>
                                            <field name="total_gross" readonly="1" force_save="1"/>
                                            <field name="total_bottom_price" readonly="1" force_save="1"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group>
                                            <field name="total_net_value" readonly="1" force_save="1"/>
                                            <field name="total_vat" readonly="1" force_save="1"/>
                                        </group>
                                        <group>
                                            <field name="total_disc_on_foc" readonly="1" force_save="1"/>
                                            <field name="total_net" readonly="1" force_save="1"/>
                                        </group>

                                    </group>
                                </group>
                            </div>
                        </page>
                        <page string="Narration">
                            <field name="narration" force_save="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--    sale quotation tree view-->
    <record id="sale_quotation_view_tree" model="ir.ui.view">
        <field name="name">sale.quotation.view.tree</field>
        <field name="model">sale.quotation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" force_save="1" invisible="1"/>
                <field name="sequence_number"/>
                <field name="date" force_save="1"/>
                <field name="partner_id" force_save="1"/>
                <field name="sales_man_id" force_save="1"/>
                <field name="total_net" force_save="1"/>
                <field name="state" widget="badge" decoration-muted="state=='cancel'"
                       decoration-info="state=='draft'" decoration-success="state=='sale'" force_save="1"/>
            </tree>
        </field>
    </record>

    <record id="sale_quotation_action" model="ir.actions.act_window">
        <field name="name">Quotation</field>
        <field name="res_model">sale.quotation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'show_default_code': True}</field>
    </record>

    <record model="ir.actions.server" id="sale_action_confirm_quotation">
        <field name="name">Confirm Quotation</field>
        <field name="model_id" ref="model_sale_quotation"/>
        <field name="binding_model_id" ref="model_sale_quotation"/>
        <field name="state">code</field>
        <field name="code">
            action = records.sale_confirm()
        </field>
    </record>
</odoo>
