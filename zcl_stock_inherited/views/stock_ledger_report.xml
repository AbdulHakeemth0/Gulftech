<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_ledger_view_tree" model="ir.ui.view">
        <field name="name">view.stock.ledger.view.tree</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <tree string="Stock Ledger">
                <field name="date" widget="date"/>
                <field name="reference"/>
                <field name="product_id"/>
                <field name="customer_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="product_uom_qty"/>
                <field name="on_hand_qty"/>
                <field name="state" widget='badge' optional="show"
                       decoration-danger="state=='cancel'"
                       decoration-info="state== 'assigned'"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state not in ('draft','cancel','done','assigned')"/>
            </tree>
        </field>
    </record>
    <record id="view_stock_ledger_search" model="ir.ui.view">
        <field name="name">stock.ledger.search</field>
        <field name="model">stock.move</field>
        <field eval="3" name="priority"/>
        <field name="arch" type="xml">
            <search string="Stock Moves">
                <field name="reference"/>
                <field name="product_id"/>
                <field name="customer_id"/>
                <field name="location_id"/>
                <field name="date"/>
                <field name="location_dest_id"/>
                <filter string="Done" name="done" domain="[('state','=','done')]" help="Stock moves that have been processed"/>
            </search>
        </field>
    </record>
    <record id="action_stock_ledger_reports" model="ir.actions.act_window">
        <field name="name">Stock Ledger</field>
        <field name="res_model">stock.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="view_stock_ledger_view_tree"/>
        <field name="search_view_id" ref="view_stock_ledger_search"/>
        <field name="context">{'search_default_done': 1}</field>
        <field name="view_mode">tree</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_stock_ledger_view_tree')})]"/>
        <!--        <field name="context">{'create': False}</field>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No orders found
            </p>
        </field>
    </record>

    <record id="view_stock_quant_ledger_view_pivot" model="ir.ui.view">
        <field name="name">view.stock.ledger.view.tree</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <pivot string="Stock Ledger">
                <field name="product_id" type="row"/>
                <field name="location_id" groups="stock.group_stock_multi_locations" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="unit_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_quant_view_tree_inherited" model="ir.ui.view">
        <field name="name">view.stock.ledger.view.tree</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="unit_price" force_save="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_stock_ledger_purchase_report" model="ir.actions.act_window">
        <field name="name">Stock Ledger</field>
        <field name="res_model">stock.quant</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">pivot</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_stock_quant_ledger_view_pivot')})]"/>
    </record>
<!---->
<!--    <menuitem action="action_stock_ledger_purchase_report" id="menu_purchase_stock_ledger" parent="zcl_purchase_bill.menu_purchase_item_movement" name="Item Movement Report"/>-->
</odoo>