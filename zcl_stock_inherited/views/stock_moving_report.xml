<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_moving_report_view" model="ir.ui.view">
        <field name="name">stock.moving.report</field>
        <field name="model">location.count.history</field>
        <field name="arch" type="xml">
            <tree string="Stock Moving Report" create="false">
                <field name="date"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="count"/>
                <field name="sale_quantity"/>
                <field name="moving_percentage"/>
            </tree>
        </field>
    </record>
    <record id="stock_moving_report_search" model="ir.ui.view">
        <field name="name">stock.moving.report</field>
        <field name="model">location.count.history</field>
        <field name="arch" type="xml">
            <search string="Stock Moving Report">
                <field name="date"/>
                <field name="location_id"/>
                <field name="product_id"/>
            </search></field></record>
    <record id="action_stock_moving_report" model="ir.actions.act_window">
            <field name="name">Stock Moving Report</field>
            <field name="res_model">location.count.history</field>
            <field name="view_mode">tree</field>
            <field name="search_view_id" ref="stock_moving_report_search"/>
    </record>
<!--    <menuitem id="menu_stock_moving" name="Stock Moving Report" action="action_stock_moving_report"-->
<!--                  parent="zcl_purchase_bill.menu_purchase_stockmoving"/>-->
</odoo>