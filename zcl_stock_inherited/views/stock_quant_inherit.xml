<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_stock_quant_tree_editable_invisible" model="ir.ui.view">
            <field name="name">stock.quant.tree.editable.invisible</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="edit">false</attribute>
                </xpath>
                <xpath expr="//tree//field[@name='reserved_quantity']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
<!--                <xpath expr="//tree//button[@name='317']" position="attributes">-->
<!--                    <attribute name="invisible">1</attribute>-->
<!--                </xpath>-->
                <xpath expr="//tree//button[@name='action_view_stock_moves']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//tree//button[@name='action_view_orderpoints']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
        <record id="view_stock_quant_form_editable_inherited" model="ir.ui.view">
            <field name="name">stock.quant.tree.editable.invisible</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_form_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="sale_quantity"/>
                </xpath>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Location Count History">
                            <button name="auto_location_history" string="CCC" type="object"/>
                            <field name="location_count_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="count"/>
                                    <field name="sale_quantity"/>
                                    <field name="moving_percentage"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>