<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_store" model="ir.sequence">
            <field name="name">Store Sequence</field>
            <field name="code">zcl_store.sequence_store</field>
            <field name="prefix">ST</field>
            <field name="padding">5</field>
            <field name="number_next_actual">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="warehouse_update_cron" model="ir.cron">
       <field name="name">Warehouse Update Schedule action</field>
       <field name="model_id" ref="model_stock_warehouse"/>
       <field name="state">code</field>
       <field name="code">model.update_warehouse_stock()</field>
       <field name="doall" eval="False"/>
   </record>
    </data>
</odoo>