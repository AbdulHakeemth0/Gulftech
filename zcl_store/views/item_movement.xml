<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="item_movement_tree_view" model="ir.ui.view">
        <field name="name">custom.stock.move.tree</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <tree string="Custom Stock Moves" create="false">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="onhand_qty"/>
                <field name="customer_name"/>
            </tree>
        </field>
    </record>

    <record id="item_movement_action" model="ir.actions.act_window">
        <field name="name">Item Movement Report</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="item_movement_tree_view"/>
        <field name="domain">[('location_dest_id.name', 'like', 'Customers')]</field>
        <field name="context">{'search_default_done': 1}</field>
    </record>

</odoo>